# ===== QDII 额度监控 · 环境变量示例 =====
# 复制为 .env 后按需修改；本地启动时会自动读取，系统环境变量优先

# ---------- 采集 ----------
QDII_CONCURRENCY=5          # 并发数，东财对高频访问敏感，建议不超过 6
QDII_TIMEOUT=20000          # 单请求超时（毫秒）
QDII_RETRIES=3              # 失败重试次数
QDII_JITTER=150             # 请求间随机抖动上限（毫秒）
QDII_DATA_DIR=./data        # 数据目录
QDII_CATALOG_FILE=./data/fund-catalog.json # 本地基金目录（默认使用项目 data 目录）
QDII_ANNOUNCEMENT_CONCURRENCY=4 # 公告列表并发数
QDII_REFRESH_ANNOUNCEMENTS=true # false 时仅使用目录基线和已缓存公告
QDII_DISCOVER_FUNDS=true       # 从天天基金目录发现12个既有主题的新份额

# ---------- 监控范围 ----------
# 只对这些方向做变动通知；置空表示通知全部
QDII_INDEXES=nasdaq100,sp500

# 低于该值的额度变动不通知（元）。0 表示任何变动都通知
QDII_MIN_DELTA=0

# ---------- 通知通道 ----------
# 可多选，逗号分隔：console | webhook | ntfy | email
QDII_NOTIFY=console
QDII_NOTIFY_STARTUP_TEST=false # true 时本地服务每次启动后自动发送测试通知

# --- webhook（按 kind 自动组装请求）---
QDII_WEBHOOK_KIND=bark      # bark | serverchan | dingtalk | feishu | wecom | generic
QDII_WEBHOOK_TOKEN=         # 对应平台的 token / key
QDII_WEBHOOK_URL=           # generic 时直接指定完整 URL

# --- ntfy（支持 ntfy.sh 或自建服务器）---
QDII_NTFY_SERVER=https://ntfy.sh
QDII_NTFY_TOPIC=            # 订阅主题，例如 qdii-my-private-topic
QDII_NTFY_TOKEN=            # 私有主题/自建服务需要时填写 Access Token
QDII_NTFY_PRIORITY=3        # 1-5：最低到最高
QDII_NTFY_TAGS=chart_with_upwards_trend,moneybag
QDII_NTFY_CLICK=            # 点击通知后打开的网址，例如 https://user.github.io/qdii-monitor/

# --- 邮件（SMTP）---
QDII_SMTP_HOST=smtp.qq.com
QDII_SMTP_PORT=465
QDII_SMTP_SECURE=true
QDII_SMTP_USER=you@example.com
QDII_SMTP_PASS=授权码
QDII_MAIL_FROM=you@example.com
QDII_MAIL_TO=you@example.com,other@example.com
